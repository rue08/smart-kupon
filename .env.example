DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=smartkupon
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Path to the Firebase service-account JSON (Project Settings > Service Accounts > Generate new private key)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=firebase-service-account.json
# Web API key (Project Settings > General) - only needed for the get_test_token management command
FIREBASE_WEB_API_KEY=

# Google Cloud OAuth client (Google Cloud Console > APIs & Services > Credentials);
# the Firebase project's underlying GCP project can be reused for this.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/sources/gmail/callback

# Fernet key encrypting stored Gmail tokens - generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

GMAIL_SYNC_INTERVAL_MINUTES=15
RUN_SCHEDULER_ON_RUNSERVER=True
